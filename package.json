{
  "name": "online-auction-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time online auction platform built as microservices (university project)",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "backend/shared/*",
    "backend/services/*",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "gen-keys": "node backend/shared/auth/scripts/gen-keys.mjs",
    "build:shared": "npm run build -w @auction/shared-common && npm run build -w @auction/shared-auth",
    "pretypecheck": "npm run build:shared",
    "pretest": "npm run build:shared",
    "rabbitmq:setup": "npm run build -w @auction/shared-common && node scripts/setup-rabbitmq.mjs",
    "test:gateway": "node --test tests/e2e/gateway-smoke.mjs",
    "test:security": "node --test tests/security/security.e2e.mjs",
    "test:events": "node --test tests/e2e/auction-events.e2e.mjs",
    "test:wallet": "node --test tests/e2e/wallet.e2e.mjs",
    "test:settlement": "node --test tests/e2e/settlement.e2e.mjs",
    "test:lifecycle": "node --test tests/e2e/lifecycle.e2e.mjs",
    "test:load-balancing": "node --test tests/e2e/load-balancing.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
