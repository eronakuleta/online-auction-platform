# API gateway (owner: Erona, task A-20). The only public entry point: TLS, routing, rate limiting.
# The nginx image fills in ${GATEWAY_*} from the environment at start, then writes this file to
# /etc/nginx/conf.d/default.conf. Nginx's own variables ($host, $uri, ...) are left untouched.
# Routing table and local TLS limits: gateway/README.md.

server_tokens off;

# One ID per request, through the gateway and every service. A client may send its own
# X-Request-Id; only safe characters are accepted (same rule as the services), otherwise nginx
# makes a new one.
map $http_x_request_id $correlation_id {
    "~^[A-Za-z0-9._-]{1,128}$" $http_x_request_id;
    default                    $request_id;
}

log_format gateway '$remote_addr [$time_iso8601] "$request_method $uri" $status '
                   '${request_time}s upstream=$upstream_addr request_id=$correlation_id';
access_log /var/log/nginx/access.log gateway;

# Rate limits per client IP. Login and register get a much stricter limit than the rest of the API,
# to slow down password guessing. Values come from .env (GATEWAY_*_RATE and GATEWAY_*_BURST).
limit_req_zone $binary_remote_addr zone=api:10m rate=${GATEWAY_API_RATE};
limit_req_zone $binary_remote_addr zone=auth:10m rate=${GATEWAY_AUTH_RATE};
limit_req_status 429;

# Open live streams (SSE) per client IP (docs/events.md §10, proposal 1): the stream needs no token,
# so this stops one client from holding thousands of connections. Over the limit: 429.
limit_conn_zone $binary_remote_addr zone=streams:10m;
limit_conn_status 429;

# Docker's internal DNS. Service names are looked up per request, not once at start, so the gateway
# starts even while a service is still missing (it answers 503 for it), and it follows a container
# that restarts with a new IP address.
resolver 127.0.0.11 valid=10s ipv6=off;

# Plain HTTP: only the health check for Docker, everything else is redirected to HTTPS.
server {
    listen 80;
    server_name _;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        return 301 https://$host:${GATEWAY_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:TLS:10m;

    # Above the largest service limit (64 kB for an auction), so services decide the exact limit.
    client_max_body_size 100k;

    # Errors the gateway creates itself use the same JSON body as the services (docs/events.md §9).
    # Errors from a service pass through unchanged.
    error_page 404             @not_found;
    error_page 413             @too_large;
    error_page 429             @rate_limited;
    error_page 502 503 504 =503 @unavailable;

    # CORS (task A-23). Allowed origins come from CORS_ALLOWED_ORIGINS. A preflight (OPTIONS) is
    # answered here and never reaches a service; for an origin not on the list the answer carries
    # no Access-Control-Allow-Origin, so the browser refuses.
    include /etc/nginx/snippets/cors.conf;
    if ($request_method = OPTIONS) {
        return 204;
    }

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id      $correlation_id;
    proxy_connect_timeout 2s;
    proxy_read_timeout    30s;

    set $auth_service         http://auth-service:3001;
    set $auction_service      http://auction-service:3002;
    set $bidding_service      http://bidding-service:3003;
    set $payment_service      http://payment-service:3004;
    set $notification_service http://notification-service:3005;

    # /internal/* is for calls between services only (CLAUDE.md, security rules). It is refused
    # anywhere in the path, after nginx has decoded %-escapes and resolved "..", with the same 404
    # as an unknown route, so it does not even reveal that it exists.
    location ~* /internal(/|$) {
        return 404;
    }

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Live auction data belongs to bidding-service. Regex locations win over the /api/v1/auctions
    # prefix below, so these never reach auction-service (ROADMAP §5).
    #
    # Load balancing (task A-21): bidding-service runs as BIDDING_REPLICAS containers under one name.
    # Docker's DNS answers with every replica's address, and because proxy_pass uses a variable,
    # nginx resolves the name per request and spreads requests round robin over all addresses.
    # Nothing has to stick to one replica: the row lock in PostgreSQL orders bids, both closing
    # workers share the work with SKIP LOCKED, and Redis pub/sub brings every update to every
    # replica's stream clients (B-12).
    location ~ ^/api/v1/auctions/[^/]+/(bids|state)$ {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $bidding_service;
    }

    # The live stream (SSE) is one long response, so the usual proxy settings would break it.
    location ~ ^/api/v1/auctions/[^/]+/stream$ {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        limit_conn streams ${GATEWAY_STREAMS_PER_IP};
        proxy_pass $bidding_service;
        # Pass each event on at once instead of collecting the response first.
        proxy_buffering off;
        proxy_cache off;
        # Keep the connection open to the service (HTTP/1.1 without "Connection: close").
        proxy_set_header Connection '';
        # The service sends a heartbeat every 15 s; without one for an hour the stream is dead.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /api/v1/auth/ {
        limit_req zone=auth burst=${GATEWAY_AUTH_BURST} nodelay;
        proxy_pass $auth_service;
    }

    location /api/v1/users {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $auth_service;
    }

    location /api/v1/auctions {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $auction_service;
    }

    location /api/v1/categories {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $auction_service;
    }

    location /api/v1/bids {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $bidding_service;
    }

    location /api/v1/wallet {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $payment_service;
    }

    location /api/v1/payments {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $payment_service;
    }

    location /api/v1/notifications {
        limit_req zone=api burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $notification_service;
    }

    # Anything else, including each service's own /health, is not public.
    location / {
        return 404;
    }

    location @not_found {
        default_type application/json;
        add_header X-Request-Id $correlation_id always;
        include /etc/nginx/snippets/cors.conf;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Route not found","details":[],"requestId":"$correlation_id"}}';
    }

    location @too_large {
        default_type application/json;
        add_header X-Request-Id $correlation_id always;
        include /etc/nginx/snippets/cors.conf;
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"Request body is too large","details":[],"requestId":"$correlation_id"}}';
    }

    location @rate_limited {
        default_type application/json;
        add_header X-Request-Id $correlation_id always;
        include /etc/nginx/snippets/cors.conf;
        add_header Retry-After 10 always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests, try again later","details":[],"requestId":"$correlation_id"}}';
    }

    location @unavailable {
        default_type application/json;
        add_header X-Request-Id $correlation_id always;
        include /etc/nginx/snippets/cors.conf;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"The service is unavailable","details":[],"requestId":"$correlation_id"}}';
    }
}
