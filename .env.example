# Copy to .env and adjust. Never commit .env.
# Every variable used by any service must be documented here.
# Later tasks add their own variables to this file.

# ---------------------------------------------------------------- General
# development | test | production
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------- PostgreSQL (one container, one DB per service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=auction
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_NAME=auth_db
AUCTION_DB_NAME=auction_db
BIDDING_DB_NAME=bidding_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# ---------------------------------------------------------------- Redis (bid cache, pub/sub for SSE)
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------- RabbitMQ (topic exchange auction.events)
RABBITMQ_USER=auction
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_URL=amqp://auction:change-me-rabbit@rabbitmq:5672
EVENTS_EXCHANGE=auction.events

# ---------------------------------------------------------------- MailHog (email simulation, STRETCH: only used if email stays in scope)
SMTP_HOST=mailhog
SMTP_PORT=1025

# ---------------------------------------------------------------- JWT (RS256). Generate keys with scripts/gen-keys.sh
# Only auth-service gets the private key. Other services get the public key only.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=auction-auth-service
JWT_AUDIENCE=auction-platform
# Access token lifetime in seconds (15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (7 days)
JWT_REFRESH_TTL_SECONDS=604800

# ---------------------------------------------------------------- Service ports
AUTH_SERVICE_PORT=3001
AUCTION_SERVICE_PORT=3002
BIDDING_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# ---------------------------------------------------------------- Service-to-service URLs (internal network, never via the gateway)
PAYMENT_SERVICE_URL=http://payment-service:3004
BIDDING_SERVICE_URL=http://bidding-service:3003
# Timeout for the bidding -> payment funds check, in milliseconds
FUNDS_CHECK_TIMEOUT_MS=2000

# ---------------------------------------------------------------- Business rules
# Anti-sniping: a bid within this many seconds of the end extends the auction
SNIPE_WINDOW_SECONDS=30
SNIPE_EXTENSION_SECONDS=30
MAX_EXTENSIONS=10
# Platform fee taken from the seller's payout, in whole percent
PLATFORM_FEE_PERCENT=5
# Single platform currency (ISO 4217)
CURRENCY=EUR

# ---------------------------------------------------------------- Security
# Comma-separated list of origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443

# ---------------------------------------------------------------- Frontend (Vite exposes only VITE_* variables to the browser)
# Base URL of the Nginx gateway
VITE_API_BASE_URL=https://localhost:8443/api/v1
